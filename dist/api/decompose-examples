[{"id": "cf-memory", "idea": "Exploit high-bandwidth RAM across many Cloudflare Edge Workers: explode a dataset too large for one machine into per-worker memory, run SIMD/MIMD-style anomaly detection and incremental training across workers, and persist only the deltas -- so a model can be trained on data that would not fit in one machine's memory. Target: live in 30 days.", "customer": "ML/infrastructure engineers who need to train a model on a dataset too large for any single machine's memory, and need a working distributed setup live within 30 days without provisioning new hardware."}, {"id": "oncall-rotation", "idea": "Fix our on-call rotation: whoever is on call must answer pages within 5 minutes, 24/7 including overnight, with no real backup plan when someone is sick or traveling.", "customer": "The 6 backend engineers who rotate through on-call, and the engineering manager who has to explain coverage gaps to leadership."}, {"id": "plumber-crm", "idea": "I run a small plumbing business, just me and four techs. I want to build an app that works like a CRM for us -- tracks our customers and jobs, but really the big thing I need is help getting invoices paid faster. Half my customers pay 30 to 60 days late and I'm constantly chasing people down for checks. Doesn't need to be fancy, just something so we stop losing track of who still owes us money.", "customer": "The plumbing business owner, who already does the scheduling and books and is the one chasing late payers, plus the four techs who need to see which jobs are billed and to whom."}, {"id": "shift-swap-marketplace", "idea": "Internal web app lets hourly retail employees post and claim shift swaps themselves, with manager approval required only when the swap changes total weekly hours beyond a threshold.", "customer": "The hourly retail employees who want to trade shifts among themselves without asking a manager every time, and the store manager who only wants to be pulled in when a swap changes someone's total weekly hours past the threshold."}, {"id": "sleep-coach-wearable", "idea": "Cheap wrist wearable nudges the user with a single vibration pattern ninety minutes before their historically best bedtime, learned from a week of sleep-tracking data, with no app needed after the initial setup week.", "customer": "An adult who wants a better bedtime routine but won't keep using an app or logging anything nightly -- they want the device to learn quietly and just nudge them."}, {"id": "smart-recycling-bin", "idea": "Neighborhood recycling bin with a camera sorts common contamination items (plastic bags, food waste) out of the recycling stream automatically before pickup, refusing bins more than 10% contaminated and texting the resident why.", "customer": "The residents of the neighborhood whose bins get sorted and who get texted when a bin is rejected, and the municipal or HOA waste-management staff who currently inspect bins and enforce contamination rules by hand."}, {"id": "standup-async", "idea": "Replace the daily standup meeting with an async, five-minute-max written update each person posts every morning in one channel, plus a short auto-generated digest that surfaces only genuine blockers so nobody has to read every update to find them.", "customer": "A software team spread across enough time zones, or interruption-sensitive enough, that a synchronous daily standup doesn't fit everyone -- and the lead who currently reads every update themselves to catch real blockers."}, {"id": "voice-extension", "idea": "Browser extension that reads any webpage aloud in the voice of a historical figure the user picks, using a small on-device text-to-speech model, no cloud calls, free tier limited to 10 minutes per day.", "customer": "A casual web reader who wants pages read aloud while doing something else, drawn to this extension over a generic text-to-speech tool by the historical-figure voice novelty."}]