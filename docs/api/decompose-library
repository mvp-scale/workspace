{"sha256": "c2b0fea0389750fab21f45736364be057c179db81e8ad5e25a08dd7b9b009e76", "space": 113, "shapes": ["functional", "non-functional", "architectural", "user-story", "technical-spec", "operational"], "categories": [{"id": "functional-core-capability", "text": "The system performs every action its users need in order to complete the task it exists for.", "shape": "functional", "children": [{"id": "func-action-inventory", "text": "The requirements name every action a user can perform in the system."}, {"id": "func-outcome-per-action", "text": "Each user action produces one defined outcome in the system."}, {"id": "func-precondition-per-action", "text": "Each user action has a stated precondition the system enforces before allowing it."}, {"id": "func-success-confirmation", "text": "The system returns a confirmation to the user when an action succeeds."}, {"id": "func-scope-exclusions", "text": "The requirements name the actions the system deliberately does not perform."}]}, {"id": "functional-data-lifecycle", "text": "The system's handling of each record it holds is defined from creation through deletion.", "shape": "functional", "children": [{"id": "func-record-creation-path", "text": "The way each record first enters the system is defined."}, {"id": "func-record-mutable-fields", "text": "The fields of an existing record that a user may change are defined."}, {"id": "func-record-deletion-effect", "text": "What becomes of a record once a user deletes it is defined."}, {"id": "func-record-retention-period", "text": "Each record type has a defined period after which the system removes it."}, {"id": "func-record-change-history", "text": "The system keeps the previous value of a record after a user changes it."}]}, {"id": "functional-access-rules", "text": "The system allows each user only the actions their role permits.", "shape": "functional", "children": [{"id": "func-role-inventory", "text": "The requirements name every user role the system recognises."}, {"id": "func-role-permission-list", "text": "Each role has a defined list of the actions it may perform."}, {"id": "func-default-permissions", "text": "A newly created account receives a defined set of permissions."}, {"id": "func-denied-action-response", "text": "The system returns a defined response when a user attempts an action their role forbids."}]}, {"id": "functional-error-behavior", "text": "The system behaves in a defined way when an operation does not succeed.", "shape": "functional", "children": [{"id": "func-invalid-input-response", "text": "The system returns a defined response when submitted input fails validation."}, {"id": "func-failure-reason-shown", "text": "The system shows the user the reason an operation failed."}, {"id": "func-partial-failure-state", "text": "The system leaves stored data in a defined state when an operation fails partway through."}, {"id": "func-retry-permission", "text": "Whether a user may retry a failed operation is defined for each operation."}]}, {"id": "nonfunctional-performance", "text": "The system's required speed is stated as a measurable target.", "shape": "non-functional", "children": [{"id": "nfr-latency-target", "text": "The maximum acceptable response time for a user-facing request is stated as a number."}, {"id": "nfr-throughput-target", "text": "The number of requests the system must handle per unit of time is stated as a number."}, {"id": "nfr-concurrency-target", "text": "The number of users the system must serve at the same time is stated as a number."}, {"id": "nfr-latency-measurement-point", "text": "The point in the request path at which the response time target is measured is named."}]}, {"id": "nonfunctional-availability", "text": "The system's required availability is stated as a measurable target.", "shape": "non-functional", "children": [{"id": "nfr-uptime-target", "text": "The required uptime is stated as a percentage over a named period."}, {"id": "nfr-recovery-time-target", "text": "The maximum time allowed to restore service after an outage is stated as a number."}, {"id": "nfr-data-loss-window", "text": "The largest period of data the business accepts losing in an outage is stated as a number."}, {"id": "nfr-maintenance-window", "text": "The maintenance window during which the uptime target does not apply is stated."}]}, {"id": "nonfunctional-data-protection", "text": "The protection required for the data the system holds is stated as a verifiable requirement.", "shape": "non-functional", "children": [{"id": "nfr-data-classification", "text": "Each stored field is assigned a defined sensitivity level."}, {"id": "nfr-encryption-standard", "text": "The encryption required for stored data is named."}, {"id": "nfr-authentication-strength", "text": "The authentication strength required before a user reaches protected data is stated."}, {"id": "nfr-access-audit-record", "text": "Every access to data at the highest sensitivity level produces an audit record."}]}, {"id": "nonfunctional-accessibility", "text": "The interface meets a named accessibility standard.", "shape": "non-functional", "children": [{"id": "nfr-accessibility-standard-version", "text": "The version of the accessibility standard the interface must meet is named."}, {"id": "nfr-keyboard-operable", "text": "Every interactive control is operable using the keyboard alone."}, {"id": "nfr-text-contrast-ratio", "text": "The minimum contrast ratio for text is stated as a number."}, {"id": "nfr-screen-reader-target", "text": "The screen reader the interface is required to work with is named."}]}, {"id": "architecture-component-boundaries", "text": "Each component of the system has one stated responsibility.", "shape": "architectural", "children": [{"id": "arch-component-inventory", "text": "The components the system is built from are listed in one place."}, {"id": "arch-component-interface", "text": "The interface through which each component is called is named."}, {"id": "arch-allowed-callers", "text": "The components each component is allowed to call are named."}, {"id": "arch-deployment-unit", "text": "Each component is assigned to a named deployment unit."}]}, {"id": "architecture-external-boundary", "text": "The architecture defines how the system behaves at each boundary with a service it does not control.", "shape": "architectural", "children": [{"id": "arch-dependency-inventory", "text": "Every external service the system calls is listed in the architecture."}, {"id": "arch-dependency-isolation", "text": "Each external service is reached through a single component that isolates it from the rest of the system."}, {"id": "arch-dependency-failure-behavior", "text": "How the system behaves while a named external service is unreachable is defined."}, {"id": "arch-dependency-data-boundary", "text": "The data the system sends to each external service is listed."}]}, {"id": "architecture-data-ownership", "text": "Each data store in the system has one component that owns it.", "shape": "architectural", "children": [{"id": "arch-write-path-single", "text": "Writes to each data store pass through its owning component."}, {"id": "arch-read-path-defined", "text": "The path by which a component reads data owned by another component is defined."}, {"id": "arch-store-technology-named", "text": "The storage technology holding each data set is named."}, {"id": "arch-schema-source-of-truth", "text": "The place where each data store's schema is defined is recorded."}]}, {"id": "story-first-use", "text": "As a new user, I can complete my first real task without anyone helping me.", "shape": "user-story", "children": [{"id": "story-self-serve-signup", "text": "As a new user, I can create my account without contacting anyone."}, {"id": "story-value-in-first-session", "text": "As a new user, I see a useful result in my first session."}, {"id": "story-try-before-committing", "text": "As a new user, I can try the system on example data before entering my own."}, {"id": "story-resume-setup", "text": "As a new user, I can stop partway through setup and resume where I left off."}]}, {"id": "story-error-recovery", "text": "As a user, I can recover from my own mistakes without asking anyone for help.", "shape": "user-story", "children": [{"id": "story-undo-last-action", "text": "As a user, I can undo the action I just took."}, {"id": "story-correct-after-submit", "text": "As a user, I can correct an entry after I have submitted it."}, {"id": "story-see-what-changed", "text": "As a user, I can see what changed after I correct an entry."}, {"id": "story-keep-partial-input", "text": "As a user, I can return to a partly filled form without retyping what I already entered."}]}, {"id": "story-administration", "text": "As an administrator, I can manage who uses the system without engineering help.", "shape": "user-story", "children": [{"id": "story-admin-add-user", "text": "As an administrator, I can add a new user myself."}, {"id": "story-admin-revoke-access", "text": "As an administrator, I can remove a person's access immediately."}, {"id": "story-admin-change-role", "text": "As an administrator, I can change a user's role without re-entering their details."}, {"id": "story-admin-review-activity", "text": "As an administrator, I can see what a given user did in the system."}]}, {"id": "spec-api-contract", "text": "The interface the system exposes is specified operation by operation.", "shape": "technical-spec", "children": [{"id": "spec-operation-inventory", "text": "Every operation the interface exposes is listed by name."}, {"id": "spec-request-field-types", "text": "Each request field has a specified data type."}, {"id": "spec-required-field-marking", "text": "Each request field states whether it is mandatory."}, {"id": "spec-response-shape", "text": "The fields returned in a successful response are specified."}, {"id": "spec-error-code-per-failure", "text": "Each failure the interface can return has a specified error code."}]}, {"id": "spec-data-model", "text": "The data the system stores is specified field by field.", "shape": "technical-spec", "children": [{"id": "spec-entity-inventory", "text": "Every entity the system stores is named."}, {"id": "spec-field-type", "text": "Each stored field has a specified data type."}, {"id": "spec-entity-identifier", "text": "Each entity has a specified unique identifier."}, {"id": "spec-relationship-cardinality", "text": "The cardinality of each relationship between entities is specified."}, {"id": "spec-field-value-range", "text": "The accepted range of values is specified for each constrained field."}]}, {"id": "spec-integration-protocol", "text": "The wire-level behaviour of each call the system makes to another system is specified.", "shape": "technical-spec", "children": [{"id": "spec-auth-scheme", "text": "The authentication scheme each outbound call uses is named."}, {"id": "spec-call-timeout", "text": "The timeout for each outbound call is specified as a number."}, {"id": "spec-retry-count", "text": "The number of retries for a failed outbound call is specified as a number."}, {"id": "spec-idempotency-key", "text": "The field that makes a repeated request safe to resend is specified."}, {"id": "spec-rate-limit", "text": "The rate limit each outbound call must stay within is stated as a number."}]}, {"id": "ops-observability", "text": "The running system emits the signals an operator needs to judge its health.", "shape": "operational", "children": [{"id": "ops-health-check-endpoint", "text": "The service exposes a health check that reports whether it can serve traffic."}, {"id": "ops-failure-rate-metric", "text": "The system emits a metric for the rate of failed requests."}, {"id": "ops-log-correlation-id", "text": "Each log line carries the identifier of the request that produced it."}, {"id": "ops-alert-threshold", "text": "The metric value at which an operator is alerted is defined."}]}, {"id": "ops-release-process", "text": "Putting a new version into production follows a defined, repeatable procedure.", "shape": "operational", "children": [{"id": "ops-single-command-deploy", "text": "One documented command deploys the current build to production."}, {"id": "ops-rollback-procedure", "text": "The procedure for returning to the previous version is written down."}, {"id": "ops-release-verification", "text": "The check that confirms a release is serving correctly is defined."}, {"id": "ops-change-record", "text": "Each production change is recorded against the person who made it."}, {"id": "ops-migration-ordering", "text": "The order in which a schema change is applied relative to the code change is defined."}]}, {"id": "ops-incident-response", "text": "A written runbook covers the failures the on-call responder is expected to handle.", "shape": "operational", "children": [{"id": "ops-expected-failure-list", "text": "The failures a responder is expected to handle are listed."}, {"id": "ops-first-response-steps", "text": "Each listed failure has written first-response steps."}, {"id": "ops-escalation-contact", "text": "The person to escalate to is named for each listed failure."}, {"id": "ops-runbook-rehearsed", "text": "The runbook has been followed at least once outside a real incident."}]}, {"id": "ops-data-recovery", "text": "Restoring the system's data from backup is a proven procedure.", "shape": "operational", "children": [{"id": "ops-backup-interval", "text": "The interval at which data is backed up is defined."}, {"id": "ops-restore-steps", "text": "The steps to restore data from a backup are written down."}, {"id": "ops-restore-rehearsed", "text": "A restore from backup has been completed successfully at least once."}, {"id": "ops-backup-isolation", "text": "Backups are stored separately from the system they protect."}]}], "profile_probes": [{"id": "sensitive-data", "text": "This idea involves handling data that would be considered sensitive or private if exposed."}, {"id": "external-integration", "text": "This idea needs to send or receive data from a third-party service it doesn't control."}, {"id": "real-time-latency", "text": "This idea has a real-time or low-latency requirement where a slow response meaningfully hurts the outcome."}, {"id": "financial-transaction", "text": "This idea involves moving or tracking money."}, {"id": "regulated-industry", "text": "This idea operates in an industry with specific regulatory compliance requirements, such as health, finance, or government."}, {"id": "multi-tenant", "text": "This idea needs to serve multiple separate organizations or customers from the same system, keeping their data apart."}, {"id": "offline-capable", "text": "This idea needs to keep working when the user has no network connection."}, {"id": "mobile-required", "text": "This idea needs a dedicated mobile app, not just a page that happens to work on a phone."}, {"id": "high-user-scale", "text": "This idea needs to support a large or fast-growing number of concurrent users, not just a small fixed group."}, {"id": "frequent-change", "text": "The underlying process or rule this idea automates changes often enough that the solution needs to be easy to reconfigure, not just built once."}], "questions": {"leaf": ["gate", "phase", "risk", "complexity", "dependency"], "phase_options": ["spike", "decide", "build", "validate", "launch"]}}