posed": "not run", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE", "reason": "pending slow clock", "provisional": true}, "size": {"outcome": "ABSTAIN_NOT_ADMITTED", "answer_or_proposed": " 21 (Nov); three (missiles); three (missiles); three (missiles)", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE"}, "traits": {"outcome": "ABSTAIN_NOT_ADMITTED", "answer_or_proposed": "not run", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE", "reason": "pending slow clock", "provisional": true}, "topic_node": {"outcome": "ANSWER_PROVISIONAL", "answer_or_proposed": "medtop:16000000", "marker": "BELOW_BAR", "harvest": "DISCARD"}}, "total_ms": 265.83, "over_budget": false, "seq": 37, "read_at": 1795289853.8380659, "lag_s": 69072.58, "gaps": ["UNBOUND_HIGH", "LANDING_SPLIT", "UNPLACED_HIGH", "NOT_ATTACHED"]}, "text": "Saudi Arabia says it intercepts three Houthi missiles targeting Riyadh. # Saudi Arabia says it intercepts three Houthi missiles targeting Riyadh Nov 21 - The Saudi-led coalition fighting Yemen's Iran-aligned Houthis said on Saturday it had intercepted and destroyed three ballistic missiles fired towards Riyadh, marking the second Houthi attack on the Saudi capital in a few days, after its tallest skyscraper was struck on Thursday. A Reuters witness saw a projectile streak across the sky in Riyadh shortly before hearing a loud bang. The projectile left a trail of smoke in the sky. The latest attack followed an escalation in cross-border strikes on Friday, when the Saudi-led coalition said it had struck the Red Sea port of Hodeidah and carried out operations targeting Houthi missile and drone capabilities in the capital Sanaa. The Houthis threatened to target Saudi Red Sea ports, warned airlines to avoid Saudi airspace, and claimed attacks on a power station and port in southern Saudi Arabia. The developments signalled a worsening of a conflict that has brought a humanitarian crisis to Yemen and severe disruption to Saudi Arabia, in parallel with the US-led war against Iran. On Thursday, a Houthi attack damaged the Public Investment Fund tower, the headquarters of Saudi Arabia's sovereign wealth fund and the tallest skyscraper in Riyadh. Saudi Arabia, a close ally of the United States, has been backing Yemen's internationally recognised government for more than a decade in a war that was fought to a stalemate in 2022 but reignited in July. The Houthis have seized Yemen's Red Sea coast and forced the Saudi-backed forces aligned with the government to retreat to defend their temporary capital in the southern port of Aden. REUTERS", "stages_full": {"windows": {"windows": 8, "cap": 12, "pct_body_read": 100, "offsets_text": [[72, 296], [297, 516], [517, 727], [728, 954], [955, 1191], [1192, 1410], [1411, 1620], [1621, 1755]]}, "scan_dates": {"spots": {"attribution": 6, "date": 4, "entity": 39, "event": 12}, "dates": [["Saturday", "2026-11-21"], ["Thursday", "2026-11-19"], ["Friday", "2026-11-20"], ["Thursday", "2026-11-19"]], "dates_resolved": 4, "anchor": "2026-11-21", "time_proxy": {"label": "time_proxy", "marker": "PROVISIONAL", "offset_days": [0, -2, -1, -2], "n": 4, "of": "resolved date minus published date, in days"}}, "facts": {"kinds": {"amount": 4, "date": 4, "name": 39, "triple": 29}, "stated": 36, "unbound": 39, "invalid": 1, "stated_amount": 4, "stated_date": 4, "quarantined": 0, "held": [], "items": [{"kind": "amount", "s": 148, "e": 151, "text": " 21", "status": "stated"}, {"kind": "amount", "s": 32, "e": 37, "text": "three", "status": "stated"}, {"kind": "amount", "s": 106, "e": 111, "text": "three", "status": "stated"}, {"kind": "amount", "s": 266, "e": 271, "text": "three", "status": "stated"}, {"kind": "date", "s": 224, "e": 232, "text": "Saturday", "status": "stated"}, {"kind": "date", "s": 425, "e": 433, "text": "Thursday", "status": "stated"}, {"kind": "date", "s": 655, "e": 661, "text": "Friday", "status": "stated"}, {"kind": "date", "s": 1195, "e": 1203, "text": "Thursday", "status": "stated"}, {"kin