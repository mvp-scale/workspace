PROVISIONAL", "answer_or_proposed": "war_conflict / diplomacy_treaties", "marker": "BELOW_BAR", "harvest": "DISCARD"}, "change": {"outcome": "ABSTAIN_NOT_ADMITTED", "answer_or_proposed": "not run", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE", "reason": "pending slow clock", "provisional": true}, "size": {"outcome": "ABSTAIN_NOT_ADMITTED", "answer_or_proposed": "two (discuss); three (sources)", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE"}, "traits": {"outcome": "ABSTAIN_NOT_ADMITTED", "answer_or_proposed": "not run", "marker": "NOT_ADMISSIBLE", "harvest": "NEEDS_JUDGE", "reason": "pending slow clock", "provisional": true}, "topic_node": {"outcome": "ABSTAIN_LOW_CONFIDENCE", "answer_or_proposed": "medtop:16000000", "marker": "BELOW_BAR", "harvest": "LABEL_QUEUE"}}, "total_ms": 261.08, "over_budget": false, "seq": 20, "read_at": 1795289849.4465356, "lag_s": 236179.79, "gaps": ["LANDING_SPLIT", "RERANK_DISAGREE", "LANDING_WEAK", "UNPLACED_HIGH", "NOT_ATTACHED"]}, "text": "Saudi crown prince meets US CENTCOM chief amid escalating Houthi hostilities. # Saudi crown prince meets US CENTCOM chief amid escalating Houthi hostilities Nov 19 - Saudi Crown Prince Mohammed bin Salman met US Central Command chief Admiral Brad Cooper in Riyadh, Cooper's third publicly reported visit to Saudi Arabia since hostilities between the kingdom and Yemen's Iran-aligned Houthis reignited in July. The two discussed bilateral relations, particularly regarding military affairs, as well as regional developments, the Saudi state news agency SPA reported on Thursday. Cooper also met Saudi Defence Minister Prince Khalid bin Salman, SPA said. They discussed defence cooperation and ways to achieve security, stability and peace in the region, SPA reported separately. Saudi Arabia, a longstanding US security partner, has faced escalating tensions with the Houthis since July, when the wider conflict in the Middle East spilled over into Yemen, prompting Riyadh to seek defensive and offensive support from allies. The Houthis have stepped up attacks on Saudi cities and energy infrastructure while advancing along Yemen's Red Sea coast towards the Bab el-Mandeb Strait, threatening a key shipping route and Saudi oil exports. In September, three sources familiar with the matter told Reuters that the crown prince had sought military assistance from US President Donald Trump to help fight the Houthis. Trump did not agree to US strikes against the group, but Washington told Riyadh it would provide intelligence-sharing and targeting assistance, the sources said. REUTERS", "stages_full": {"windows": {"windows": 7, "cap": 12, "pct_body_read": 100, "offsets_text": [[78, 297], [298, 544], [545, 793], [794, 1023], [1023, 1236], [1237, 1481], [1482, 1583]]}, "scan_dates": {"spots": {"attribution": 7, "date": 2, "entity": 42, "event": 2, "modal": 1, "negation": 1}, "dates": [["Nov 19", "2026-11-19"], ["Thursday", "2026-11-19"]], "dates_resolved": 2, "anchor": "2026-11-19", "time_proxy": {"label": "time_proxy", "marker": "PROVISIONAL", "offset_days": [0, 0], "n": 2, "of": "resolved date minus published date, in days"}}, "facts": {"kinds": {"amount": 2, "date": 2, "name": 42, "triple": 19}, "stated": 42, "unbound": 23, "invalid": 0, "stated_amount": 2, "stated_date": 2, "quarantined": 0, "held": [], "items": [{"kind": "amount", "s": 414, "e": 417, "text": "two", "status": "stated"}, {"kind": "amount", "s": 1251, "e": 1256, "text": "three", "status": "stated"}, {"kind": "date", "s": 157, "e": 163, "text": "Nov 19", "status": "stated"}, {"kind": "date", "s": 568, "e": 576, "text": "Thursday", "status": "stated"}, {"kind": "name", "s": 0, "e": 5, "text": "Saudi", "status": "unbound"}, {"kind": "name", "s": 25, "e": 35, "text": "US CENTCOM", "status": "unbound"}, {"kind": "name", "s": 58, "e": 64, "text": "Houthi", "status": "unbound"}, {"kind": "name", "s": 80, "e": 85, "text": "Saudi", "status": "unbound"}, {"kind": "name", "s": 105, "e": 115, "text": "US CENTCOM", "st