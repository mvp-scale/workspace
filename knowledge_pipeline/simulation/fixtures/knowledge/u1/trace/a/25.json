o, which has faced pressure from President Donald Trump to intensify a crackdown on drug cartels. Trump has threatened unilateral military action in Mexico if his administration believes enough is not being done to combat them. REUTERS", "stages_full": {"windows": {"windows": 7, "cap": 12, "pct_body_read": 100, "offsets_text": [[78, 264], [264, 445], [445, 652], [653, 892], [893, 1104], [1105, 1321], [1321, 1435]]}, "scan_dates": {"spots": {"attribution": 4, "date": 3, "entity": 27, "event": 6, "modal": 1, "negation": 2, "quote": 1}, "dates": [["Nov 23", "2026-11-23"], ["Monday", "2026-11-23"], ["Friday", "2026-11-20"]], "dates_resolved": 3, "anchor": "2026-11-23", "time_proxy": {"label": "time_proxy", "marker": "PROVISIONAL", "offset_days": [0, 0, -3], "n": 3, "of": "resolved date minus published date, in days"}}, "facts": {"kinds": {"amount": 5, "date": 3, "name": 27, "triple": 18}, "stated": 34, "unbound": 19, "invalid": 0, "stated_amount": 5, "stated_date": 3, "quarantined": 0, "held": [], "items": [{"kind": "amount", "s": 447, "e": 450, "text": " 10", "status": "stated"}, {"kind": "amount", "s": 848, "e": 852, "text": " 361", "status": "stated"}, {"kind": "amount", "s": 875, "e": 878, "text": " 14", "status": "stated"}, {"kind": "amount", "s": 485, "e": 488, "text": "two", "status": "stated"}, {"kind": "amount", "s": 903, "e": 906, "text": "two", "status": "stated"}, {"kind": "date", "s": 170, "e": 176, "text": "Nov 23", "status": "stated"}, {"kind": "date", "s": 377, "e": 383, "text": "Monday", "status": "stated"}, {"kind": "date", "s": 543, "e": 549, "text": "Friday", "status": "stated"}, {"kind": "name", "s": 0, "e": 2, "text": "US", "status": "unbound"}, {"kind": "name", "s": 41, "e": 48, "text": "Mexican", "status": "unbound"}, {"kind": "name", "s": 60, "e": 76, "text": "El Chapo Isidro'", "status": "stated"}, {"kind": "name", "s": 80, "e": 82, "text": "US", "status": "unbound"}, {"kind": "name", "s": 121, "e": 128, "text": "Mexican", "status": "unbound"},