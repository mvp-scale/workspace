# This workspace's settings for the Kaggle toolkit in tools/kaggle/ (the toolkit itself knows nothing about this workspace).
# Use: source tools/kaggle.env; tools/kaggle/watch.sh <owner/slug> <out> [max-min] [poll-s] [push-dir]
export KAGGLE_RUNS_LEDGER=/workspace/data/kaggle/runs.jsonl
# Show Kaggle runs on the status line and the Trainer page.
export KAGGLE_ON_EVENT='s=$2; [ "$s" = running ] && s=training; python3 /workspace/newsreader/bitmob/progress.py event "$1" "$s" "$3" --pid "$4"'
